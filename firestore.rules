rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      // Assuming superadmins are identified by a custom claim or a specific role in the players collection.
      // For this app, we check the role in the players collection.
      return isAuthenticated() && 
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Organizers and platform staff.
    function isStaff() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['organiser', 'superadmin', 'admin'])
      );
    }

    // Profile merges: typed-in tournament player -> registered account.
    match /playerLinks/{linkId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isStaff());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isStaff());
    }

    // Wallet redeem codes. Creating one must lower the player's balance by the same
    // amount in the same write; staff can only mark an unused code as used.
    match /redemptions/{code} {
      allow get, list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'issued'
        && request.resource.data.amount > 0
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.walletPoints
           == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.walletPoints - request.resource.data.amount;
      allow update: if isStaff()
        && resource.data.status == 'issued'
        && request.resource.data.status == 'used'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy', 'bookingRef']);
      allow delete: if false;
    }

    // Users
    match /users/{userId} {
      // Users can read/write their own document, but never their own role: the role
      // decides organiser/admin access (isStaff), so only a superadmin sets it.
      allow read: if isOwner(userId) || isSuperAdmin();
      allow list: if isAuthenticated() && resource.data.email == request.auth.token.email || isSuperAdmin();
      allow create: if isSuperAdmin() || (isOwner(userId) && request.resource.data.get('role', 'player') == 'player');
      allow update: if isSuperAdmin() || (isOwner(userId) && request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if isSuperAdmin();
    }
    // Players
    match /players/{userId} {
      // Players can read and write only their own document. Superadmins can read/write all.
      allow read, list: if true;
      // `role` is what isSuperAdmin() checks, so nobody can give it to themselves.
      allow create: if (isOwner(userId) && request.resource.data.get('walletPoints', 0) == 0
        && request.resource.data.get('role', 'player') == 'player') || isSuperAdmin();
      // Referees (authenticated) update stats. Nobody but a superadmin can raise a
      // wallet balance, and only the owner can spend it.
      allow update: if isSuperAdmin() || (isAuthenticated() &&
        request.resource.data.get('role', null) == resource.data.get('role', null) && (
        request.resource.data.get('walletPoints', 0) == resource.data.get('walletPoints', 0) ||
        (isOwner(userId) && request.resource.data.get('walletPoints', 0) < resource.data.get('walletPoints', 0))
      ));
      allow delete: if isSuperAdmin();
    }

    // Venues
    match /venues/{venueId} {
      // Anyone can read venues (needed for dropdowns and display)
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Courts
    match /courts/{courtId} {
      // Anyone can read courts
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Organizers
    match /organizers/{organizerId} {
      // Anyone can read organizers
      allow read: if true;
      // FIX (found live via local testing of the real app): deductOrganiserCredits/
      // refundOrganiserCredits run as the ORGANIZER'S OWN session (self-service
      // credit spend when creating a tournament), not as a superadmin —
      // write:if isSuperAdmin() made every real organizer's tournament
      // creation fail with "Failed to deduct credits" even with credits
      // available. An organizer may now update ONLY their own
      // matchCreditsRemaining/matchCreditsUsed split, and only in a way that
      // conserves the total (remaining+used must stay unchanged) — covers
      // both deduction and refund while making it impossible for an
      // organizer to grant themselves new credits by crafting an arbitrary
      // client write. Every other field stays superadmin-only.
      allow update: if isSuperAdmin() || (
        isOwner(organizerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matchCreditsRemaining', 'matchCreditsUsed']) &&
        request.resource.data.matchCreditsRemaining is number &&
        request.resource.data.matchCreditsUsed is number &&
        request.resource.data.matchCreditsRemaining >= 0 &&
        (request.resource.data.matchCreditsRemaining + request.resource.data.matchCreditsUsed) ==
          (resource.data.matchCreditsRemaining + resource.data.matchCreditsUsed)
      );
      allow create, delete: if isSuperAdmin();
    }

    // Referees
    match /referees/{refereeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /matches/{matchId}/events/{eventId} {
      allow read: if true;
      allow create: if
        isAuthenticated()
        && request.resource.data.keys().hasAll([
            'type','scoringTeam','scoringPlayerId',
            'shotType','setNum','scoreAfter'
          ])
        && request.resource.data.type in [
            'point','fault','let','timeout','match_end'
          ];
      allow update, delete: if false; // immutable!
    }

    match /matches/{matchId} {
      allow read: if true;
      allow update, create: if isAuthenticated();
      // FIX: deleteMatch() deletes this doc and its tournament-subcollection
      // copy in one atomic batch — the subcollection half can succeed for
      // the organizer via the tournaments/{id}/{document=**} write rule, but
      // this top-level collection never granted delete to anyone, so the
      // whole batch always failed with "Missing or insufficient permissions"
      // for every user, including superadmin. Scoped to the match's own
      // tournament's organizer or superadmin, matching the pattern already
      // used for tournament deletes below.
      allow delete: if isAuthenticated() && (
        get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.organizerId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // FIX (found live, local testing of the real app): PublicLandingStats.tsx
    // runs collectionGroup(db, 'matches') to power the public landing page's
    // live match/tournament counters. A collection-group query needs its own
    // rule matching the recursive `{path=**}/matches/{id}` pattern — being
    // reachable via the top-level /matches rule above, or via the
    // tournaments/{id}/{document=**} wildcard, is NOT sufficient for
    // collection-group reads, only for reading one specific document by its
    // full path. Without this, the landing page threw permission-denied on
    // load for every visitor.
    match /{path=**}/matches/{matchId} {
      allow read: if true;
    }

    // Admin Users
    match /adminUsers/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId || isSuperAdmin();
      allow list: if isAuthenticated() && resource.data.email == request.auth.token.email || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.organizerId == request.auth.uid || 
        request.resource.data.organizerEmail == request.auth.token.email ||
        request.resource.data.adminTag == request.auth.token.email ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid || 
        resource.data.organizerEmail == request.auth.token.email ||
        resource.data.adminTag == request.auth.token.email ||
        isSuperAdmin() ||
        // Referees (anonymous sign-in) update standings, never who owns the
        // tournament or its passcode.
        (request.auth.token.firebase.sign_in_provider == 'anonymous' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizerId', 'organizerEmail', 'adminTag', 'refereePasscode']))
      );
      allow delete: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid || 
        resource.data.organizerEmail == request.auth.token.email ||
        resource.data.adminTag == request.auth.token.email ||
        isSuperAdmin()
      );

      // Public read, restricted write for general subcollections
      match /{document=**} {
        allow read: if true;
        allow write: if isAuthenticated() && (
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid || 
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerEmail == request.auth.token.email ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.adminTag == request.auth.token.email ||
          isSuperAdmin() ||
          request.auth.token.firebase.sign_in_provider == 'anonymous'
        );
      }

      // Specific rule for match updates to allow referees (anonymous auth + passcode check in UI)
      match /matches/{matchId} {
        allow update, create: if isAuthenticated();
      }
    }

    // OBS Index
    match /obsIndex/{matchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Quickplay Sessions
    match /quickplaySessions/{sessionId} {
      // Players can read any quickPlaySession they are listed in
      allow read: if true; // Actually, the prompt says "Players can read any quickPlaySession they are listed in", but if it's shared via QR, maybe public read is better? Let's stick to the prompt: we can check if auth.uid is in players array, OR if it's public for guests. Wait, prompt says "Scores and the running session tally are visible in real time to all participants, including guests who are not signed in." So read must be public.
      
      // Anyone can create a session if they are signed in
      allow create: if isAuthenticated();
      
      // Any signed-in player in the session can enter the score
      allow update: if isAuthenticated(); // We could restrict to players in the session, but for MVP, auth is enough.
      allow delete: if isSuperAdmin();
    }

    // Promo Codes
    match /promoCodes/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated(); // Allow updates for incrementing uses
      allow delete: if isSuperAdmin();
    }

    
    // Teams
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // FIX (found live, local testing of the real app): the public landing
    // page's GlobalLeaderboard queries this top-level collection, but it
    // had no rule block at all, so it was denied by default for every
    // visitor. Written by finalizePlayerTournamentGlobalPoints when a
    // tournament's results get folded into the global leaderboard — same
    // public-read / authenticated-write shape as globalStats/teams above.
    match /leaderboard/{playerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Quick Sessions
    match /quickSessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Global Stats
    match /globalStats/{docId} {
      // Publicly readable
      allow read: if true;
      // Writable only by authenticated users via server-side increment (or client-side increment)
      allow write: if isAuthenticated();
    }

    match /onboardedTeams/{teamId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /onboardedPlayers/{playerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ---------------------------------------------------------------- Futsal
    // Separate collections so padel code never reads them. Public read; the
    // organiser who owns a competition (or a superadmin) manages it; captains
    // register and edit their own squad; scorers update matches with the same
    // passcode + anonymous sign-in model padel referees use.
    function futsalOwns(tournamentId) {
      let t = get(/databases/$(database)/documents/futsalTournaments/$(tournamentId)).data;
      return isAuthenticated() && (
        t.organizerId == request.auth.uid ||
        (t.organizerEmail != '' && t.organizerEmail == request.auth.token.email) ||
        isSuperAdmin()
      );
    }
    function isRealUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /futsalTournaments/{id} {
      allow read: if true;
      allow create: if isRealUser() && request.resource.data.organizerId == request.auth.uid;
      allow update: if futsalOwns(id) && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if futsalOwns(id);
    }

    match /futsalTeams/{id} {
      allow read: if true;
      allow create: if futsalOwns(request.resource.data.tournamentId) || (
        isRealUser() &&
        request.resource.data.captainUid == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        get(/databases/$(database)/documents/futsalTournaments/$(request.resource.data.tournamentId)).data.status == 'REGISTRATION'
      );
      // Captains can change their squad and contact details, never status, group or seed.
      // The captain is matched by account, or by their email when the organiser imported the team.
      allow update: if futsalOwns(resource.data.tournamentId) || (
        isRealUser() &&
        (resource.data.captainUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.get('captainEmail', '') != '' &&
           request.auth.token.email.lower() == resource.data.captainEmail.lower())) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'shortName', 'color', 'logoUrl', 'captainName', 'captainPhone', 'captainEmail', 'players'])
      );
      allow delete: if futsalOwns(resource.data.tournamentId);
    }

    match /futsalMatches/{id} {
      allow read: if true;
      allow create: if futsalOwns(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId && (
        futsalOwns(resource.data.tournamentId) ||
        (isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous')
      );
      allow delete: if futsalOwns(resource.data.tournamentId);
    }

    // ---------------------------------------------------------------- Player squads
    // Teams a player builds for themselves. Members (by email) can list and open
    // them; only the owner changes or deletes one, and ownership can't move.
    match /playerSquads/{id} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.token.email != null && request.auth.token.email.lower() in resource.data.members)
      );
      allow create: if isRealUser() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isRealUser() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isRealUser() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------------------------------------------------------------- Quick Play
    // Casual matches a player sets up. Signed-in users can open one by its id
    // (shared with the referee code); only the host and invited players can list
    // them. The host edits everything; a referee (any signed-in user holding the
    // match link) may change only the score.
    match /quickMatches/{id} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        (request.auth.token.email != null && request.auth.token.email.lower() in resource.data.invites)
      );
      allow create: if isRealUser() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'events', 'status', 'winner', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }
    // Quick Play community leaderboard: a finished match's points per player, keyed by a hash of
    // their email (no addresses). Any signed-in user can read it; only the match's host can publish
    // it, and only for a match that has actually finished.
    match /quickBoard/{matchId} {
      allow read: if isAuthenticated();
      allow create, update: if isRealUser()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.matchId == matchId
        && get(/databases/$(database)/documents/quickMatches/$(matchId)).data.hostUid == request.auth.uid
        && get(/databases/$(database)/documents/quickMatches/$(matchId)).data.status == 'COMPLETED';
      allow delete: if isRealUser() && resource.data.hostUid == request.auth.uid;
    }
    // Referee code -> match id. Looked up by exact code only; never listed or changed.
    match /quickCodes/{code} {
      allow get: if true;
      allow list, update: if false;
      allow create: if isRealUser() && request.resource.data.hostUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }

    // FIX (found live via local testing of the real app): enrollTeamManually
    // (and other flows) write here to queue confirmation emails via
    // Firebase's "Trigger Email" extension, but this collection had no rule
    // block at all in the reverted baseline — it fell to default-deny,
    // silently failing "Enroll Team" for every organizer. Clients only ever
    // create a doc here (the extension's own backend, running with admin
    // privileges, is what actually sends and updates delivery status); no
    // client should ever read, update, or delete a queued message.
    match /mail/{mailId} {
      allow create: if isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow read, update, delete: if false;
    }
  }
}
